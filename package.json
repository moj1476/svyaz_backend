{
  "name": "svyaz-backend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.20.0",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "pnpm prisma:generate && pnpm schema:build && pnpm contracts:generate && tsc -p tsconfig.json",
    "schema:build": "tsx scripts/schema.ts",
    "typecheck": "pnpm prisma:generate && tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "check": "pnpm prisma:validate && pnpm format:check && pnpm lint && pnpm typecheck",
    "start": "node --env-file=.env dist/scripts/start.js",
    "start:read": "node --env-file=.env dist/scripts/start.js --read-only",
    "start:lab4": "node --env-file=.env dist/scripts/start.js --lab4",
    "dev": "node --env-file=.env --import tsx scripts/start.ts --dev",
    "infra:up": "docker compose --env-file .env -f infra/compose.yaml up -d --wait",
    "infra:stop": "docker compose --env-file .env -f infra/compose.yaml stop",
    "db:migrate": "node --env-file=.env --import tsx scripts/storage.ts migrate",
    "db:seed": "node --env-file=.env --import tsx scripts/storage.ts seed",
    "read": "tsx --env-file=.env scripts/read.ts",
    "command": "tsx --env-file=.env scripts/command.ts",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "contracts:generate": "graphql-codegen --config codegen.yml && tsx scripts/generate-contracts.ts",
    "db:seed:sql": "node --env-file=.env --import tsx scripts/storage.ts seed --sql-only",
    "prisma:generate": "node --import tsx scripts/prisma.ts generate",
    "prisma:validate": "node --import tsx scripts/prisma.ts validate",
    "prisma:format": "node --import tsx scripts/prisma.ts format",
    "prisma:studio": "node --env-file=.env --import tsx scripts/prisma.ts studio",
    "db:dev": "node --env-file=.env --import tsx scripts/prisma.ts dev",
    "db:status": "node --env-file=.env --import tsx scripts/prisma.ts status"
  },
  "dependencies": {
    "@apollo/server": "^5.0.0",
    "@as-integrations/express5": "^1.1.0",
    "@graphile/depth-limit": "^0.4.0",
    "@grpc/grpc-js": "1.14.0",
    "@grpc/proto-loader": "0.8.0",
    "@nestjs/apollo": "^13.0.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/graphql": "^13.0.0",
    "@nestjs/platform-express": "^11.1.0",
    "@opensearch-project/opensearch": "^3.9.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dataloader": "^2.2.3",
    "graphql": "^16.11.0",
    "graphql-query-complexity": "^2.0.0",
    "graphql-scalars": "^2.0.1",
    "kafkajs": "2.2.4",
    "pg": "^8.16.0",
    "redis": "^5.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@graphql-codegen/add": "^7.1.1",
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/typescript": "^6.1.2",
    "@graphql-codegen/typescript-resolvers": "^6.1.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "eslint": "^10",
    "eslint-config-prettier": "^10",
    "globals": "^16",
    "graphql-codegen-typescript-validation-schema": "^0.19.0",
    "prettier": "^3",
    "prisma": "7.10.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8"
  },
  "imports": {
    "#config": "./dist/packages/config/src/index.js",
    "#config/*": "./dist/packages/config/src/*.js",
    "#contracts": "./dist/packages/contracts/src/index.js",
    "#contracts/*": "./dist/packages/contracts/src/*.js",
    "#runtime/*": "./dist/packages/runtime/src/*.js",
    "#storage/*": "./dist/packages/storage/src/*.js",
    "#apps/*": "./dist/apps/*.js",
    "#adapters/*": "./dist/adapters/*.js",
    "#generated/*": "./dist/generated/*.js"
  }
}
