{
  "name": "svyaz-backend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.20.0",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "pnpm prisma:generate && pnpm schema:build && pnpm contracts:generate && tsc -p tsconfig.json",
    "schema:build": "tsx scripts/schema.ts",
    "typecheck": "pnpm prisma:generate && tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "check": "pnpm prisma:validate && pnpm format:check && pnpm lint && pnpm typecheck",
    "start": "node --env-file=.env dist/apps/graphql-api/src/main.js",
    "start:mock": "node --env-file=.env dist/apps/graphql-api/src/main.js",
    "start:lab4": "node --env-file=.env dist/apps/graphql-api/src/main.js --lab4",
    "dev": "tsx --env-file=.env apps/graphql-api/src/main.ts",
    "infra:up": "docker compose --env-file .env -f infra/compose.yaml up -d --wait",
    "infra:stop": "docker compose --env-file .env -f infra/compose.yaml stop",
    "db:migrate": "node --env-file=.env --import tsx scripts/storage.ts migrate",
    "db:seed": "node --env-file=.env --import tsx scripts/storage.ts seed",
    "read": "tsx --env-file=.env scripts/read.ts",
    "command": "tsx --env-file=.env scripts/command.ts",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "contracts:generate": "tsx scripts/generate-contracts.ts",
    "db:seed:sql": "node --env-file=.env --import tsx scripts/storage.ts seed --sql-only",
    "prisma:generate": "node --import tsx scripts/prisma.ts generate",
    "prisma:validate": "node --import tsx scripts/prisma.ts validate",
    "prisma:format": "node --import tsx scripts/prisma.ts format",
    "prisma:studio": "node --env-file=.env --import tsx scripts/prisma.ts studio",
    "db:dev": "node --env-file=.env --import tsx scripts/prisma.ts dev",
    "db:status": "node --env-file=.env --import tsx scripts/prisma.ts status"
  },
  "dependencies": {
    "@apollo/server": "^5.0.0",
    "@as-integrations/express5": "^1.1.0",
    "@nestjs/apollo": "^13.0.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/graphql": "^13.0.0",
    "@nestjs/platform-express": "^11.1.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "graphql": "^16.11.0",
    "graphql-type-json": "^0.3.2",
    "pg": "^8.16.0",
    "redis": "^5.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "eslint": "^10",
    "eslint-config-prettier": "^10",
    "globals": "^16",
    "prettier": "^3",
    "prisma": "7.10.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8"
  }
}
